// =============================================================================
//  Human Growth App - Prisma Schema
//  POC - スキルクエスト RPG
//  人事評価システム連携を見据えた設計 (external_id, evaluations テーブル)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
//  Employee — 社員。HR システム連携のキー
// -----------------------------------------------------------------------------
model Employee {
  id           String    @id @default(uuid())
  externalId   String?   @unique @map("external_id")     // HR システム側の社員ID
  cognitoSub   String    @unique @map("cognito_sub")      // Cognito の sub
  email        String    @unique
  displayName  String    @map("display_name")
  department   String?
  joinedAt     DateTime  @map("joined_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  character         Character?
  evaluations       Evaluation[]
  reviewedDocuments QuestDocument[] @relation("ReviewedDocuments")

  @@map("employees")
}

// -----------------------------------------------------------------------------
//  Character — RPG キャラクター。Employee 1:1
// -----------------------------------------------------------------------------
model Character {
  id              String   @id @default(uuid())
  employeeId      String   @unique @map("employee_id")
  name            String
  className       String   @map("class_name")             // 例: "Engineer", "Designer"
  experiencePoint Int      @default(0) @map("experience_point")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee          Employee           @relation(fields: [employeeId], references: [id])
  quests            Quest[]
  characterSkills   CharacterSkill[]
  uploadedDocuments QuestDocument[]    @relation("UploadedDocuments")
  testAttempts      QuestTestAttempt[]

  @@map("characters")
}

// -----------------------------------------------------------------------------
//  Skill — スキルツリーのノード
// -----------------------------------------------------------------------------
model Skill {
  id          String   @id @default(uuid())
  code        String   @unique                            // 例: "frontend-react-basic"
  name        String
  description String
  tier        Int      @default(1)                        // 1〜5 スキルツリーの階層
  parentId    String?  @map("parent_id")                  // 前提スキル
  createdAt   DateTime @default(now()) @map("created_at")

  parent          Skill?           @relation("SkillTree", fields: [parentId], references: [id])
  children        Skill[]          @relation("SkillTree")
  characterSkills CharacterSkill[]

  @@map("skills")
}

model CharacterSkill {
  characterId String   @map("character_id")
  skillId     String   @map("skill_id")
  acquiredAt  DateTime @default(now()) @map("acquired_at")

  character Character @relation(fields: [characterId], references: [id])
  skill     Skill     @relation(fields: [skillId], references: [id])

  @@id([characterId, skillId])
  @@map("character_skills")
}

// -----------------------------------------------------------------------------
//  Quest — クエスト (業務タスク)
// -----------------------------------------------------------------------------
enum QuestDifficulty {
  EASY
  NORMAL
  HARD
  EPIC
}

enum QuestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

// クエスト完了の要件レベル。
// NONE     : その要件は使わない (UI も表示しない)
// OPTIONAL : 提出/受験できるが、完了には不要
// REQUIRED : 提出/合格が完了の必須条件
enum QuestRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

model Quest {
  id                   String           @id @default(uuid())
  title                String
  description          String
  difficulty           QuestDifficulty  @default(NORMAL)
  rewardXp             Int              @map("reward_xp")
  status               QuestStatus      @default(OPEN)
  assignedCharacterId  String?          @map("assigned_character_id")
  documentRequirement  QuestRequirement @default(NONE) @map("document_requirement")
  testRequirement      QuestRequirement @default(NONE) @map("test_requirement")
  completedAt          DateTime?        @map("completed_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  assignedCharacter Character?         @relation(fields: [assignedCharacterId], references: [id])
  documents         QuestDocument[]
  questions         QuestQuestion[]
  testAttempts      QuestTestAttempt[]

  @@index([assignedCharacterId])
  @@index([status])
  @@map("quests")
}

// -----------------------------------------------------------------------------
//  QuestDocument — クエストに添付する書類。アップロード後 PENDING、管理者が承認/却下。
//  ファイル本体は S3 (DOCUMENTS_BUCKET) に保存、DB は metadata と status のみ。
// -----------------------------------------------------------------------------
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model QuestDocument {
  id                     String         @id @default(uuid())
  questId                String         @map("quest_id")
  uploadedByCharacterId  String         @map("uploaded_by_character_id")
  s3Key                  String         @unique @map("s3_key")
  filename               String
  mimeType               String         @map("mime_type")
  sizeBytes              Int            @map("size_bytes")
  status                 DocumentStatus @default(PENDING)
  reviewedByEmployeeId   String?        @map("reviewed_by_employee_id")
  reviewedAt             DateTime?      @map("reviewed_at")
  rejectionReason        String?        @map("rejection_reason")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  quest               Quest      @relation(fields: [questId], references: [id], onDelete: Cascade)
  uploadedByCharacter Character  @relation("UploadedDocuments", fields: [uploadedByCharacterId], references: [id])
  reviewedByEmployee  Employee?  @relation("ReviewedDocuments", fields: [reviewedByEmployeeId], references: [id])

  @@index([questId])
  @@index([status])
  @@index([uploadedByCharacterId])
  @@map("quest_documents")
}

// -----------------------------------------------------------------------------
//  QuestQuestion / QuestChoice — クエスト内テスト (クイズ) の設問と選択肢
//  単一選択のみ。正解は isCorrect=true のものを 1 つ持つ。
// -----------------------------------------------------------------------------
model QuestQuestion {
  id        String   @id @default(uuid())
  questId   String   @map("quest_id")
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quest   Quest         @relation(fields: [questId], references: [id], onDelete: Cascade)
  choices QuestChoice[]

  @@index([questId])
  @@map("quest_questions")
}

model QuestChoice {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  text       String
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int     @default(0)

  question QuestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quest_choices")
}

// -----------------------------------------------------------------------------
//  QuestTestAttempt — 受験記録。passed=true があれば完了ゲートを通過。
// -----------------------------------------------------------------------------
model QuestTestAttempt {
  id          String   @id @default(uuid())
  questId     String   @map("quest_id")
  characterId String   @map("character_id")
  score       Int      // 正解数
  total       Int      // 設問数
  passed      Boolean
  submittedAt DateTime @default(now()) @map("submitted_at")

  quest     Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id])

  @@index([questId, characterId])
  @@index([characterId, passed])
  @@map("quest_test_attempts")
}

// -----------------------------------------------------------------------------
//  Evaluation — 人事評価 (HR システム連携用、POC では雛形のみ)
// -----------------------------------------------------------------------------
model Evaluation {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  externalId   String?  @unique @map("external_id")       // HR システム側の評価ID
  period       String                                      // 例: "2026-Q1"
  score        Int                                         // 1〜5
  comment      String?
  evaluatedAt  DateTime @map("evaluated_at")
  syncedAt     DateTime @default(now()) @map("synced_at") // HR システムから同期した時刻
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([period])
  @@map("evaluations")
}
