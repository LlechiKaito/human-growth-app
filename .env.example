# ============================================================================
# .env.example — このファイルをコピーして .env を作成
#   cp .env.example .env
#
# ローカルで全機能を確認したいだけなら、ADMIN_EMAILS だけ書き換えて他は default
# のままで OK。docker-compose.yml が ${VAR:-default} で hardcode しているため。
# ============================================================================

# ============================================================================
# 管理者として扱うメールアドレス (LocalAuthProvider のみ)
# このメールで signup すると nav に「管理 (クエスト)」が出現する
# 複数指定する場合はカンマ区切り
# ============================================================================
ADMIN_EMAILS=admin@example.com

# ============================================================================
# Database (PostgreSQL on docker-compose)
# host: postgres (= compose service 名), localhost (= ホスト) どちらも可
# ============================================================================
DATABASE_URL=postgresql://dev:dev@postgres:5432/human_growth

# ============================================================================
# API
# ============================================================================
API_PORT=8080
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:3000

# Auth provider: 'local' (LocalAuthProvider) または 'cognito' (CognitoAuthProvider)
AUTH_PROVIDER=local

# Local 用の JWT 署名鍵 (16 文字以上必須)
AUTH_LOCAL_SECRET=dev-secret-change-me-in-prod-please-1234567890

# ============================================================================
# Cognito (本番接続したいときだけ、CDK 出力値を入れる)
# ============================================================================
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-northeast-1

# ============================================================================
# Web (Next.js)
# NEXT_PUBLIC_* は build 時にバンドルされる → ローカル dev では空でOK
# (Next.js dev サーバが /api/* を api コンテナにプロキシするため)
# ============================================================================
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
