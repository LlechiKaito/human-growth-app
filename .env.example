# ============================================================================
# .env.example — このファイルをコピーして .env を作成
#   cp .env.example .env
# ============================================================================

# ============================================================================
# 認証方式の選択
# ============================================================================

# --- パターン A: ローカル完結 (AWS 不要、ユーザーはメモリ上に保持) ---
# AUTH_PROVIDER=local
# ADMIN_EMAILS=admin@example.com

# --- パターン B: ローカルから本番 Cognito を叩く (本番と同じ挙動、データ永続化) ---
AUTH_PROVIDER=cognito
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-northeast-1

# ============================================================================
# AWS 認証 (Cognito / S3 で AWS API を叩くとき必要)
# ~/.aws/credentials の profile を docker-compose が mount する
# ============================================================================
AWS_PROFILE=default
AWS_REGION=ap-northeast-1

# ============================================================================
# S3 documents bucket
# 空のままだと InMemoryStorageService にフォールバック (ファイル消える)
# 本番 S3 を使うなら CDK release 後の出力を入れる:
#   aws cloudformation describe-stacks --stack-name human-growth-dev-documents \
#     --query "Stacks[0].Outputs[?OutputKey=='DocumentsBucketName'].OutputValue" --output text
# ============================================================================
DOCUMENTS_BUCKET=

# ============================================================================
# Database (PostgreSQL on docker-compose、ローカル固定)
# ============================================================================
DATABASE_URL=postgresql://dev:dev@postgres:5432/human_growth

# ============================================================================
# API その他
# ============================================================================
API_PORT=8080
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:3000
AUTH_LOCAL_SECRET=dev-secret-change-me-in-prod-please-1234567890

# ============================================================================
# Web (Next.js) — NEXT_PUBLIC_* は build 時にバンドル
# ローカル dev では空でOK (Next.js dev サーバが /api/* を api コンテナにプロキシ)
# ============================================================================
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
