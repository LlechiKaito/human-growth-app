# ============================================================================
# .env.example — このファイルをコピーして .env を作成
#   cp .env.example .env
# ============================================================================

# ============================================================================
# 認証方式の選択 (どっちか好きな方)
# ============================================================================

# --- パターン A: ローカルで完結 (AWS 不要、ユーザーはコンテナ内メモリに保持) ---
# AUTH_PROVIDER=local
# ADMIN_EMAILS=admin@example.com

# --- パターン B: ローカルから本番 Cognito を叩く (本番と同じ挙動、データ永続化) ---
AUTH_PROVIDER=cognito
COGNITO_USER_POOL_ID=ap-northeast-1_kX8ePVGer
COGNITO_CLIENT_ID=7bunm7tu0r406hsf2vv6u4s93d
COGNITO_REGION=ap-northeast-1
# AWS CLI の profile (~/.aws/credentials の [default] や [dev] 等)
AWS_PROFILE=default
AWS_REGION=ap-northeast-1
# Cognito 上で admins グループに追加されたユーザーのみが管理画面に入れる:
#   aws cognito-idp admin-add-user-to-group \
#     --user-pool-id ap-northeast-1_kX8ePVGer \
#     --username your-email@example.com \
#     --group-name admins

# ============================================================================
# Database (PostgreSQL on docker-compose、ローカル固定)
# ============================================================================
DATABASE_URL=postgresql://dev:dev@postgres:5432/human_growth

# ============================================================================
# API その他
# ============================================================================
API_PORT=8080
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:3000
AUTH_LOCAL_SECRET=dev-secret-change-me-in-prod-please-1234567890

# ============================================================================
# Web (Next.js) — NEXT_PUBLIC_* は build 時にバンドル
# ローカル dev では空でOK (Next.js dev サーバが /api/* を api コンテナにプロキシ)
# ============================================================================
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
