# ====================================================================
# Database (PostgreSQL)
# ====================================================================
DATABASE_URL=postgresql://dev:dev@postgres:5432/human_growth

# ====================================================================
# API
# ====================================================================
API_PORT=8080
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:3000

# Auth provider: 'local' (LocalAuthProvider) または 'cognito' (CognitoAuthProvider)
AUTH_PROVIDER=local
AUTH_LOCAL_SECRET=dev-secret-change-me-in-prod-please

# ローカル開発時に admins グループとして扱うメールアドレス (LocalAuthProvider のみ)
# 例: admin@example.com,boss@example.com
ADMIN_EMAILS=

# ====================================================================
# Cognito (POC: ローカルでは空でOK、本番では CDK 出力値を入れる)
# ====================================================================
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-northeast-1

# ====================================================================
# Web (Next.js)
# ====================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
